#!/bin/sh
# brunos-diag 1: diagnóstico SÓ DE LEITURA do servidor, para o Claude Code ajudar o Bruno a achar
# problemas do BrunOS sem precisar de prints. É o único programa que a chave do usuário claude-diag
# pode rodar (restrict,command= no authorized_keys); nada aqui muda o servidor.
# Aceita só: ajuda | sistema | discos | script | registro-atualizacao | apt | runtipi |
# journal <brunos-atualizar|ssh|docker|kernel> | logs-brunos | app <app>:<loja>
# Para desligar: apague /home/claude-diag/.ssh/authorized_keys (ou o usuário claude-diag).
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
if [ "$(id -u)" -ne 0 ]; then
  set -f
  set -- ${SSH_ORIGINAL_COMMAND:-ajuda}
  set +f
fi
falha() { echo "$1" >&2; exit 2; }
app_ok() {
  case "$1" in [a-z0-9]*:[a-z0-9]*) ;; *) return 1 ;; esac
  case "$1" in *[!a-z0-9._:-]*|*:*:*) return 1 ;; esac
  [ ${#1} -le 129 ]
}
if [ $# -lt 1 ] || [ $# -gt 2 ]; then falha "pedido inválido"; fi
acao=$1
arg=${2:-}
case "$acao" in
  ajuda|sistema|discos|script|registro-atualizacao|apt|runtipi|logs-brunos) [ $# -eq 1 ] || falha "pedido inválido" ;;
  journal)
    [ $# -eq 2 ] || falha "pedido inválido"
    case "$arg" in brunos-atualizar|ssh|docker|kernel) ;; *) falha "unidade não permitida" ;; esac ;;
  app)
    [ $# -eq 2 ] || falha "pedido inválido"
    app_ok "$arg" || falha "app inválido" ;;
  *) falha "pedido inválido (rode: ajuda)" ;;
esac
if [ "$acao" = ajuda ]; then
  echo "sistema | discos | script | registro-atualizacao | apt | runtipi | journal <brunos-atualizar|ssh|docker|kernel> | logs-brunos | app <app>:<loja>"
  exit 0
fi
if [ "$(id -u)" -ne 0 ]; then exec sudo -n /usr/local/sbin/brunos-diag "$@"; fi
# daqui para baixo roda como root (pelo sudo), com o pedido já conferido duas vezes; só leitura
runtipi_dir() { sed -n 's/^RUNTIPI=//p' /etc/brunos-host.conf 2>/dev/null | head -n 1; }
case "$acao" in
  sistema)
    uname -a; head -n 4 /etc/os-release; uptime; free -h
    df -h -x tmpfs -x devtmpfs -x overlay -x squashfs 2>/dev/null || df -h ;;
  discos)
    lsblk -o NAME,TRAN,SIZE,FSTYPE,MOUNTPOINT,MODEL,SERIAL
    echo "=== kernel (USB, discos)"
    dmesg -T 2>/dev/null | grep -iE 'uas|reset|I/O error|ata[0-9]|sd[a-z]' | tail -n 40 || true ;;
  script)
    /usr/local/sbin/brunos-host versao 2>&1 || true
    cat /etc/brunos-host.conf 2>/dev/null || echo "(sem /etc/brunos-host.conf)"
    ls -l /usr/local/sbin/brunos-host /etc/sudoers.d/brunos-power 2>&1 || true ;;
  registro-atualizacao)
    tail -n 200 /var/log/brunos-atualizar.log 2>/dev/null || echo "(sem registro)" ;;
  apt)
    ls /etc/apt/sources.list.d/
    echo "=== para atualizar"
    apt list --upgradable 2>/dev/null | sed -n '2,101p'
    echo "=== histórico"
    tail -n 40 /var/log/apt/history.log 2>/dev/null || true ;;
  runtipi)
    d=$(runtipi_dir)
    [ -n "$d" ] || falha "sem a pasta do Runtipi em /etc/brunos-host.conf"
    echo "=== apps"; ls "$d/apps"/* 2>/dev/null
    echo "=== backups"; ls -R "$d/backups" 2>/dev/null | head -n 60 || true
    (cd "$d" && ./runtipi-cli version 2>&1) || true ;;
  journal)
    if [ "$arg" = kernel ]; then journalctl -k -n 120 --no-pager; else journalctl -u "$arg" -n 150 --no-pager; fi ;;
  logs-brunos)
    for c in $(docker ps -a --format '{{.Names}}' | grep -i brunos); do
      echo "=== $c"; docker logs --tail 200 "$c" 2>&1
    done ;;
  app)
    d=$(runtipi_dir)
    [ -n "$d" ] || falha "sem a pasta do Runtipi em /etc/brunos-host.conf"
    id=${arg%%:*}
    loja=${arg#*:}
    # a configuração do app (sem o app.env, que tem senhas) e o tamanho de cada pasta de dados
    for f in docker-compose.json docker-compose.yml config.json; do
      [ -f "$d/apps/$loja/$id/$f" ] && { echo "=== $f"; cat "$d/apps/$loja/$id/$f"; }
    done
    echo "=== tamanho dos dados (app-data/$loja/$id)"
    timeout 50 du -sh "$d/app-data/$loja/$id"/* 2>/dev/null || echo "(sem app-data)"
    echo "=== backups"
    ls -la "$d/backups/$loja/$id" 2>/dev/null || echo "(nenhum)" ;;
esac
